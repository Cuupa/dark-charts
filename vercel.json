{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "git": {
    "deploymentEnabled": true
  },
  "github": {
    "silent": true,
    "autoJobCancelation": true
  },
 
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/streaming-snapshots",
      "schedule": "0 22 * * 0"
    },
    {
      "path": "/api/cron/aggregate-charts",
      "schedule": "55 23 * * 0"
    },
    {
      "path": "/api/cron/reset-credits",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron/evaluate-badges",
      "schedule": "15 0 * * 1"
    },
    {
      "path": "/api/cron/purge-inactive",
      "schedule": "30 5 * * 1"
    },
    {
      "path": "/api/cron/sync-itunes-artwork",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/sync/queue",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/sync",
      "schedule": "*/10 * * * *"
    }
  ]
}
